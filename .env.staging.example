ENVIRONMENT=production

POSTGRES_USER=beautyflow_staging
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=beautyflow_staging
DATABASE_URL=postgresql+psycopg://beautyflow_staging:replace-with-a-strong-random-password@postgres:5432/beautyflow_staging
REDIS_PASSWORD=replace-with-a-strong-random-password

ALGORITHM=HS256
USER_SECRET_KEY=replace-with-at-least-32-random-characters
USER_SECRET_KEY_ID=user-current
USER_SECRET_KEY_FALLBACKS=
INTEGRATION_SECRET_KEY=replace-with-at-least-32-random-characters
INTEGRATION_SECRET_KEY_ID=integration-current
INTEGRATION_SECRET_KEY_FALLBACKS=
BUSINESS_INTEGRATION_SECRET_KEY=replace-with-at-least-32-random-characters
BUSINESS_INTEGRATION_SECRET_KEY_ID=business-integration-current
BUSINESS_INTEGRATION_SECRET_KEY_FALLBACKS=

USER_ACCESS_TOKEN_EXPIRE_MINUTES=30
USER_REFRESH_TOKEN_EXPIRE_DAYS=7
INTEGRATION_TOKEN_EXPIRE_DAYS=30
BUSINESS_INTEGRATION_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=https://staging-admin.example.com
FORWARDED_ALLOW_IPS=replace-with-staging-reverse-proxy-ip
TRUSTED_PROXY_IPS=replace-with-staging-reverse-proxy-ip
USER_REFRESH_COOKIE_SECURE=true
ADMIN_COOKIE_SECURE=true

N8N_ERROR_WEBHOOK_URL=https://n8n.techlegacy.com.br/webhook/beautyflow-error-staging
N8N_WEBHOOK_HEADER=X-Beautyflow-Webhook-Secret
N8N_WEBHOOK_SECRET=replace-with-the-existing-staging-shared-secret

# Both providers are enabled only in staging for migration validation.
WHATSAPP_ENABLED_PROVIDERS=evolution,covercut
WHATSAPP_DEFAULT_PROVIDER=covercut

# Existing Evolution staging compatibility.
EVOLUTION_API_URL=https://evolution-staging.example.com
EVOLUTION_API_KEY=replace-with-the-staging-evolution-api-key
EVOLUTION_WEBHOOK_URL=https://n8n.techlegacy.com.br/webhook/beautyflow-staging
EVOLUTION_INSTANCE_PREFIX=beautyflow-staging
EVOLUTION_REQUEST_TIMEOUT_SECONDS=15

# CoverCut account dedicated to staging.
COVERCUT_API_BASE_URL=https://api.covercut.com.br/api/v1
COVERCUT_API_KEY=replace-with-the-covercut-staging-api-key
COVERCUT_API_SECRET=replace-with-the-covercut-staging-api-secret
COVERCUT_REQUEST_TIMEOUT_SECONDS=15
COVERCUT_MESSAGE_WEBHOOK_SECRET=replace-with-the-message-webhook-secret
COVERCUT_SAAS_WEBHOOK_SECRET=replace-with-the-saas-webhook-secret
COVERCUT_N8N_WEBHOOK_URL=https://n8n.techlegacy.com.br/webhook/beautyflow-staging
COVERCUT_EXTERNAL_ID_PREFIX=beautyflow-staging
COVERCUT_MEDIA_MAX_BYTES=20971520
COVERCUT_REMINDER_TEMPLATE_NAME=appointment_reminder
COVERCUT_REMINDER_TEMPLATE_LANGUAGE=pt_BR

LOG_LEVEL=INFO
TZ=America/Sao_Paulo
